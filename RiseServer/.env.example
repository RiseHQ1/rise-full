# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rise_db?schema=public"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_ACCESS_SECRET="rise_access_secret_super_secure_key_min_32_characters_long_12345"
JWT_REFRESH_SECRET="rise_refresh_secret_super_secure_key_min_32_characters_long_12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Apple Authentication & APNs
APPLE_CLIENT_ID="com.riseapp.rise2026"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# RevenueCat Integration
REVENUECAT_WEBHOOK_AUTH_KEY="rise_rc_webhook_secret_key_prod_test"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"
