# ==========================================
# Rise Server — Production Environment Variables
# Copy to .env.production and fill in secure values
# ==========================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------
POSTGRES_USER=rise_admin
POSTGRES_PASSWORD=RiseDB_Pass_2026!
POSTGRES_DB=rise_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rise_admin:RiseDB_Pass_2026!@postgres:5432/rise_production?schema=public

# ------------------------------------------
# Redis Configuration (BullMQ & Cache)
# ------------------------------------------
REDIS_PASSWORD=RiseRedis_Pass_2026!
REDIS_PORT=6379
REDIS_URL=redis://:RiseRedis_Pass_2026!@redis:6379

# ------------------------------------------
# JWT & Authentication Secrets
# ------------------------------------------
JWT_SECRET=41acb74c8037a05d4a9ad3d5bf1661e332f1de075b5d6ac8f939ecfbcbe40c74
JWT_REFRESH_SECRET=8e7a64fb46cde11762d6c3e40f01359d06d9a7cd5c50dc3828ca0e1bd9b583ea
ADMIN_API_KEY=Rise@2026!!!
ENCRYPTION_KEY=c1264b7a1f87e24db61e6da49e47095df7a76e241ce4a3bdc0d192166c55d6c8

# ------------------------------------------
# AI Providers (Optional - Leave blank for fallback)
# ------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------
# RevenueCat Webhooks & StoreKit
# ------------------------------------------
REVENUECAT_WEBHOOK_AUTH=YOUR_REVENUECAT_WEBHOOK_SECRET_KEY

# ------------------------------------------
# Apple Push Notification Service (APNs)
# ------------------------------------------
APNS_KEY_ID=YOUR_APNS_KEY_ID
