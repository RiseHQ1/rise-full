# ==========================================
# Rise Server — Production Environment Variables
# Copy to .env.production and fill in secure values
# ==========================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------
POSTGRES_USER=rise_admin
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE
POSTGRES_DB=rise_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rise_admin:YOUR_STRONG_POSTGRES_PASSWORD_HERE@postgres:5432/rise_production?schema=public

# ------------------------------------------
# Redis Configuration (BullMQ & Cache)
# ------------------------------------------
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD_HERE@redis:6379

# ------------------------------------------
# JWT & Authentication Secrets
# ------------------------------------------
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_ACCESS_TOKENS
JWT_REFRESH_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_REFRESH_TOKENS
ADMIN_API_KEY=YOUR_ADMIN_PANEL_MASTER_SECRET_KEY
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------
# AI Providers (Optional - Leave blank for fallback)
# ------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------
# RevenueCat Webhooks & StoreKit
# ------------------------------------------
REVENUECAT_WEBHOOK_AUTH=YOUR_REVENUECAT_WEBHOOK_SECRET_KEY

# ------------------------------------------
# Apple Push Notification Service (APNs)
# ------------------------------------------
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=com.riseapp.ios
APNS_PRIVATE_KEY_PATH=/app/certs/AuthKey_APNS.p8
